# ---- Core runtime ---------------------------------------------------------
NODE_ENV=production
PORT=3000

# Public base URL used in QR codes and join links. On Railway this defaults to
# https://$RAILWAY_PUBLIC_DOMAIN when left blank.
PUBLIC_URL=

# Facilitator console PIN. Anyone with this PIN can control live operations.
ADMIN_PIN=replace-with-a-six-digit-pin

# Secret used to sign the facilitator cookie. Use at least 32 random chars.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
COOKIE_SECRET=replace-with-at-least-32-random-characters

# ---- Database -------------------------------------------------------------
# Railway PostgreSQL connection string. When empty, the embedded PGlite
# database under DATA_DIR is used instead (fine for local development).
DATABASE_URL=

# Force TLS for PostgreSQL. Defaults to on when NODE_ENV=production.
# Set to false for a local Docker Postgres without TLS.
PGSSL=

# ---- Optional -------------------------------------------------------------
DATA_DIR=./data
PGLITE_DIR=./data/pglite
SESSION_RETENTION_HOURS=24
# Comma-separated extra origins allowed to open the Socket.IO connection.
ALLOWED_ORIGINS=
LOG_LEVEL=info
