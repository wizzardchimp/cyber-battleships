{
  "name": "cyber-battleships",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Cyber Battleships - real-time multiplayer cyber security awareness game",
  "main": "server/index.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "concurrently -k -n server,client -c cyan,magenta \"node --watch server/index.js\" \"vite --host\"",
    "dev:server": "node --watch server/index.js",
    "dev:client": "vite --host",
    "build": "vite build",
    "start": "node server/index.js",
    "test": "node --test test/*.test.js",
    "test:watch": "node --test --watch test/*.test.js"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.3.0",
    "compression": "^1.7.5",
    "cookie": "^1.0.2",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "pg": "^8.13.1",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "qrcode": "^1.5.4",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "vite": "^6.0.7"
  }
}
